[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
x509_extensions = v3_req

[dn]
CN = worksyne.local.test

[v3_req]
subjectAltName = @alt_names

[alt_names]
DNS.1 = worksyne.local.test
DNS.2 = api.worksyne.local.test
DNS.3 = www.worksyne.local.test
DNS.4 = www.api.worksyne.local.test
